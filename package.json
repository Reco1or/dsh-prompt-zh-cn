{
  "name": "dsh-prompt-zh-cn",
  "version": "0.2.0",
  "description": "在运行时把 DeepSeek Harness 内置的系统提示词 sections、运行时上下文、注入消息与工具定义替换为中文，不修改任何 DSH 源码，卸载即恢复英文。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dict",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "MODEL_VS_UI.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chinese",
    "zh-cn",
    "system-prompt",
    "localization"
  ],
  "license": "MIT"
}